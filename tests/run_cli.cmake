# Runs the CLI with optional stdin/stdout redirection and checks the result.
#   -DEXE=... -DARGS="a|b|c" [-DSTDIN=file] [-DSTDOUT=file] [-DEXPECT_EXIT=0]
#   [-DSAME_AS=file]         stdout/output must be byte-identical to file
#   [-DNOT_LARGER_THAN=file] OUTPUT file must not exceed the size of file
#   [-DOUTPUT=file]          output file to check with NOT_LARGER_THAN
cmake_minimum_required(VERSION 3.21)
if(NOT DEFINED EXPECT_EXIT)
  set(EXPECT_EXIT 0)
endif()
string(REPLACE "|" ";" ARGS "${ARGS}")
set(redirect)
if(DEFINED STDIN)
  list(APPEND redirect INPUT_FILE "${STDIN}")
endif()
if(DEFINED STDOUT)
  list(APPEND redirect OUTPUT_FILE "${STDOUT}")
endif()
execute_process(COMMAND "${EXE}" ${ARGS} ${redirect} RESULT_VARIABLE rc ERROR_VARIABLE err)
message("${err}")
if(NOT rc EQUAL EXPECT_EXIT)
  message(FATAL_ERROR "exit code ${rc}, expected ${EXPECT_EXIT}")
endif()
if(DEFINED STDOUT)
  file(READ "${STDOUT}" head LIMIT 5 HEX)
  if(NOT head STREQUAL "255044462d")
    message(FATAL_ERROR "stdout does not start with %PDF-")
  endif()
endif()
if(DEFINED SAME_AS)
  set(produced "${STDOUT}")
  if(DEFINED OUTPUT)
    set(produced "${OUTPUT}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${produced}" "${SAME_AS}" RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    message(FATAL_ERROR "${produced} differs from ${SAME_AS}")
  endif()
endif()
if(DEFINED NOT_LARGER_THAN)
  file(SIZE "${OUTPUT}" out_size)
  file(SIZE "${NOT_LARGER_THAN}" ref_size)
  message("output ${out_size} bytes, reference ${ref_size} bytes")
  if(out_size GREATER ref_size)
    message(FATAL_ERROR "output is larger than ${NOT_LARGER_THAN}")
  endif()
endif()
